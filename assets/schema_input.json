{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/isoseq/master/assets/schema_input.json",
    "title": "nf-core/isoseq pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "seq_data": {
                "type": "string",
                "pattern": "^\\S+\\.(bam|fa|fa\\.gz)$",
                "format": "file-path",
                "errorMessage": "Sequence data file must be provided, cannot contain spaces and must have extension '.bam', '.fa' or '.fa.gz'"
            },
            "pbi": {
                "anyOf": [
                    {
                        "type": "string",
                        "pattern": "^\\S+\\.bam\\.pbi$",
                        "format": "file-path"
                    },
                    {
                        "type": "string",
                        "pattern": "^none$"
                    }
                ],
                "errorMessage": "PacBio index for a subreads BAM must have extension '.bam.pbi' and cannot contain spaces. Use 'none' when no index applies."
            },
            "start_from": {
                "type": "string",
                "enum": ["ccs", "lima", "refine", "mapping"],
                "errorMessage": "start_from must be one of: ccs, lima, refine, mapping",
                "meta": ["start_from"]
            }
        },
        "required": ["sample", "seq_data", "start_from"]
    }
}
