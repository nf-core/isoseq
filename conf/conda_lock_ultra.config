/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pin the uLTRA Conda environments to the exact package set of the uLTRA
    container image, so `-profile conda` reproduces the container profiles and a
    single nf-test snapshot is valid under both.

    ultra_bioinformatics=0.1 declares all 10 of its dependencies (minimap2,
    namfinder, parasail-python, python-edlib, pysam, ...) with no version
    constraints, so an unpinned solve picks current builds - e.g. minimap2 2.31
    today vs 2.26 in the container - which changes alignments.

    The lock files are linux-64 explicit specs; on arm64 there is no container
    package set to pin against, so we fall back to the module environment.yml.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'ULTRA_ALIGN' {
        conda = System.getProperty('os.arch').toLowerCase() in ['aarch64', 'arm64'] ? "${projectDir}/modules/nf-core/ultra/align/environment.yml" : "${projectDir}/modules/nf-core/ultra/align/.conda-lock/linux_amd64-container-pinned.txt"
    }
    withName: 'ULTRA_INDEX' {
        conda = System.getProperty('os.arch').toLowerCase() in ['aarch64', 'arm64'] ? "${projectDir}/modules/nf-core/ultra/index/environment.yml" : "${projectDir}/modules/nf-core/ultra/index/.conda-lock/linux_amd64-container-pinned.txt"
    }
}
